# PostgreSQL connection string
DATABASE_URL=postgresql://localhost/medical_agent

# JWT signing secret. MUST be set to a real random value — the app refuses to
# start without one (see routers/auth.py). Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Get your free API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Home Assistant Integration (Optional)
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=your_long_lived_access_token

# Fixed pre-shared key for the one physical RFID enrollment station at the
# admin desk (see routers/rfid.py's ensure_fixed_station). Generate once:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
# Put the SAME value here and in the ESP32's setup portal ("Device API
# Key" field) / project_config.h. The backend auto-registers a matching
# RfidDevice row on startup — the app never generates or shows this key.
# The station's LAN IP is NOT configured here — it self-reports via POST
# /api/rfid/checkin right after connecting to WiFi, so there's nothing to
# look up in Serial Monitor or type in by hand, even after a DHCP change.
RFID_STATION_DEVICE_KEY=
